# Copy to .env at repo root and fill in your keys (never commit .env)

OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
AGENT_TIMEOUT_SEC=240
PYTHON_REPL_TIMEOUT_SEC=30

# MCP server (optional — defaults shown)
# DATALENS_API_URL=http://127.0.0.1:8000
# DATALENS_MCP_HOST=127.0.0.1
# DATALENS_MCP_PORT=8010
